/* Launch Button Style */
.launch-btn {
    background-color: #ff007f;
    color: white;
    border: none;
    padding: 8px 15px;
    margin-top: 15px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    width: 100%;
    transition: background 0.2s;
}
.launch-btn:hover {
    background-color: #ff3399;
}

/* Pop-up Screen Layout */
.modal {
    display: none; 
    position: fixed; 
    z-index: 1000; 
    left: 0; top: 0;
    width: 100%; height: 100%;
    background-color: rgba(15, 12, 27, 0.95);
}
.modal-content {
    width: 85%; height: 85%;
    margin: 5% auto;
    position: relative;
    border: 3px solid #00ffcc;
    box-shadow: 0 0 30px rgba(0, 255, 204, 0.3);
}
.close-btn {
    position: absolute;
    top: -40px; right: 0;
    color: #00ffcc;
    font-size: 1.2rem;
    cursor: pointer;
    font-weight: bold;
}
iframe {
    border: none;
    background: #000;
}
